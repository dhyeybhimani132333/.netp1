
@model P7.Models.Feedback

<h2 class="text-center mb-4">Give Your Feedback</h2>

@using (Html.BeginForm("Submit", "Feedback", FormMethod.Post))
{
    <div class="form-group">
        @Html.LabelFor(m => m.Name)

        @Html.TextBoxFor(
            m => m.Name,
            new { @class = "form-control", placeholder = "Enter your name" }
        )

        @Html.ValidationMessageFor(
            m => m.Name,
            "",
            new { @class = "text-danger" }
        )
    </div>

    <br />

    <div class="form-group">
        @Html.LabelFor(m => m.Email)

        @Html.TextBoxFor(
            m => m.Email,
            new { @class = "form-control", placeholder = "Enter your email" }
        )

        @Html.ValidationMessageFor(
            m => m.Email,
            "",
            new { @class = "text-danger" }
        )
    </div>

    <br />

    <div class="form-group">
        @Html.LabelFor(m => m.Message)

        @Html.TextAreaFor(
            m => m.Message,
            new
            {
                @class = "form-control",
                rows = "4",
                placeholder = "Write your feedback"
            }
        )

        @Html.ValidationMessageFor(
            m => m.Message,
            "",
            new { @class = "text-danger" }
        )
    </div>

    <br />

    <div class="form-group">
        @Html.LabelFor(m => m.Rating)

        @Html.DropDownListFor(
            m => m.Rating,
            new List<SelectListItem>
            {
                new SelectListItem { Text = "1 - Poor", Value = "1" },
                new SelectListItem { Text = "2 - Average", Value = "2" },
                new SelectListItem { Text = "3 - Good", Value = "3" },
                new SelectListItem { Text = "4 - Very Good", Value = "4" },
                new SelectListItem { Text = "5 - Excellent", Value = "5" }
            },
            "Select Rating",
            new { @class = "form-control" }
        )

        @Html.ValidationMessageFor(
            m => m.Rating,
            "",
            new { @class = "text-danger" }
        )
    </div>

    <br />

    <div class="text-center">
        <input type="submit"
               value="Submit Feedback"
               class="btn btn-primary" />
    </div>
}
